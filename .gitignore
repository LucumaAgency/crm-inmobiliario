node_modules/
.env
.env.local
*.log
logs/

# Planos y renders subidos. Fuera de public/ a propósito: ese directorio se borra
# en cada build y llega versionado en cada despliegue.
uploads/
.DS_Store

# Los dist y el public/ SÍ se versionan: los compila GitHub Actions y Plesk solo
# hace pull. El servidor no compila (ver docs/DEPLOY-PLESK.md).
*.tsbuildinfo
packages/*/tsconfig.tsbuildinfo

# Generado por `prisma generate` en cada entorno: trae un motor binario propio
# del sistema operativo, así que nunca se commitea.
node_modules/.prisma/
