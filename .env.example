# --- Base de datos (MariaDB 10.6 de Plesk) ---
DATABASE_URL="mysql://usuario:password@localhost:3306/lucuma_crm"

# --- App ---
NODE_ENV=production
PORT=3000
APP_URL=https://crm.ejemplo.com          # URL pública del CRM (modo de un solo cliente)

# Un subdominio por cliente: bastion.crmlucuma.com, proba.crmlucuma.com...
# Sin definir, la aplicación funciona en modo de un solo cliente y usa APP_URL.
# CRM_BASE_DOMAIN=crmlucuma.com
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
COOKIE_NAME=lcrm_session

# --- SMTP (usar cuenta real, no sendmail del hosting) ---
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=crm@ejemplo.com
SMTP_PASS=
MAIL_FROM="Lucuma CRM <crm@ejemplo.com>"

# --- Meta Lead Ads (ver docs/META-LEAD-ADS.md) ---
# Sin META_APP_SECRET el webhook responde 503 y no entra ningun lead de Meta: sin firma
# no hay forma de distinguir un aviso de Meta de uno inventado, y este canal crea leads
# sin sesion. Se saca de la configuracion de la app en developers.facebook.com.
META_APP_SECRET=
# Cadena inventada por nosotros. Se escribe igual aqui y en el alta del webhook en Meta.
META_VERIFY_TOKEN=
# Version del Graph API. Meta retira las viejas cada ~2 anos.
META_GRAPH_VERSION=v21.0

# WhatsApp usa la MISMA app y el MISMO webhook que Meta Lead Ads: no hay variables
# propias. El token de cada numero se guarda cifrado en la base (ver docs/WHATSAPP.md).

# --- Secretos guardados en la base ---
# Clave del cifrado de los page access token de Meta (AES-256-GCM). Si no se define, se
# deriva de JWT_SECRET. Definirla aparte permite rotar JWT_SECRET sin perder los tokens.
SECRETS_KEY=

# --- Worker ---
WORKER_BATCH=25
