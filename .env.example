# --- Base de datos (MariaDB 10.6 de Plesk) ---
DATABASE_URL="mysql://usuario:password@localhost:3306/lucuma_crm"

# --- App ---
NODE_ENV=production
PORT=3000
APP_URL=https://crm.ejemplo.com          # URL pública del CRM (para los magic links)
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
COOKIE_NAME=lcrm_session

# --- SMTP (usar cuenta real, no sendmail del hosting) ---
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=crm@ejemplo.com
SMTP_PASS=
MAIL_FROM="Lucuma CRM <crm@ejemplo.com>"

# --- Worker ---
WORKER_BATCH=25
