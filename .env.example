# --- Base de datos (MariaDB 10.6 de Plesk) ---
DATABASE_URL="mysql://usuario:password@localhost:3306/lucuma_crm"

# --- App ---
NODE_ENV=production
PORT=3000
APP_URL=https://crm.ejemplo.com          # URL pública del CRM (modo de un solo cliente)

# Un subdominio por cliente: bastion.crmlucuma.com, proba.crmlucuma.com...
# Sin definir, la aplicación funciona en modo de un solo cliente y usa APP_URL.
# CRM_BASE_DOMAIN=crmlucuma.com
JWT_SECRET=cambia-esto-por-algo-largo-y-aleatorio
COOKIE_NAME=lcrm_session

# --- SMTP (usar cuenta real, no sendmail del hosting) ---
SMTP_HOST=smtp.ejemplo.com
SMTP_PORT=587
SMTP_USER=crm@ejemplo.com
SMTP_PASS=
MAIL_FROM="Lucuma CRM <crm@ejemplo.com>"

# --- Worker ---
WORKER_BATCH=25
